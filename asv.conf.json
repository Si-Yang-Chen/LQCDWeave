{
  "version": 1,
  "project": "lqcdweave",
  "repo": ".",
  "branches": ["main"],
  "environment_type": "virtualenv",
  "pythons": ["3.11"],
  "matrix": {
    "numpy": ["1.26.4"]
  },
  "benchmark_dir": "benchmarks/asv",
  "env_dir": ".asv/env",
  "results_dir": ".asv/results",
  "html_dir": ".asv/html",
  "build_command": [
    "python -m pip wheel --no-deps -w {build_cache_dir} {build_dir}"
  ],
  "install_timeout": 600,
  "default_benchmark_timeout": 300,
  "build_cache_size": 2
}
